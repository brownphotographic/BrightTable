# Maintainer: Rob Brown <brownphotographic@gmail.com>
#
# Mirrors the Flatpak module's build recipe (see app/flatpak/*.yml and
# app/scripts/build-flatpak.mjs): a plain `cargo build --release` against
# the app's own Cargo.toml with `tauri/custom-protocol` explicitly enabled
# (not `cargo tauri build` - the bundling that CLI adds on top isn't needed
# here, makepkg does that job), then a manual install of the resulting
# binary + the existing Flatpak .desktop/icon/metainfo files, which describe
# the app identically regardless of packaging format.
#
# NOTE: BrightTable's git tags aren't consistently named (mix of "1.0.3",
# "v1.0.4", "v1.2" as of this writing) - the tag for a given release does
# NOT always match pkgver exactly, and a release with patch version 0 may
# be tagged as the shortened "x.y" rather than "x.y.0". Rather than hand-
# maintaining that mapping per release, probe GitHub for whichever tag
# form actually exists. GitHub's archive extracts to "BrightTable-<tag>"
# with a leading "v" stripped if the tag starts with "vN" (e.g. tag "v1.2"
# -> "BrightTable-1.2"), which _srcdir mirrors.
pkgname=brighttable
pkgver=1.2.1
pkgrel=1
pkgdesc="Connect an Immich library to external RAW editors"
arch=('x86_64')
url="https://github.com/brownphotographic/BrightTable"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'openssl' 'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'pkgconf' 'xdotool' 'file')

_short=${pkgver%.0}
_tag=
for _cand in "$pkgver" "v$pkgver" "$_short" "v$_short"; do
  if curl -fsSL --head -o /dev/null \
      "https://github.com/brownphotographic/BrightTable/archive/refs/tags/$_cand.tar.gz"; then
    _tag=$_cand
    break
  fi
done
if [[ -z $_tag ]]; then
  error "brighttable: no git tag matches pkgver=$pkgver (tried $pkgver, v$pkgver, $_short, v$_short) - check the release tag and pkgver"
  return 1
fi
_srcdir=BrightTable-${_tag#v}

source=("$pkgname-$pkgver.tar.gz::https://github.com/brownphotographic/BrightTable/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP') # replace with the real hash via `updpkgsums` before publishing

build() {
  cd "$srcdir/$_srcdir/app"

  npm ci
  npm run build
  cargo build --release --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol
}

package() {
  cd "$srcdir/$_srcdir/app"

  install -Dm755 "src-tauri/target/release/app" "$pkgdir/usr/bin/brighttable"
  install -Dm644 "flatpak/io.github.brownphotographic.BrightTable.desktop" \
    "$pkgdir/usr/share/applications/io.github.brownphotographic.BrightTable.desktop"
  install -Dm644 "src-tauri/icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.brownphotographic.BrightTable.png"
  install -Dm644 "flatpak/io.github.brownphotographic.BrightTable.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.brownphotographic.BrightTable.metainfo.xml"
  install -Dm644 "../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

app/nautilus-raw-thumbnails/
uploads/
screenshots/
.claude/
design/
scan-secrets.sh

# Stray credential-vault files - only ever land here if Preferences ->
# Configuration's folder picker gets pointed at the repo itself by mistake
# (e.g. picking .../Documents/GitHub/BrightTable instead of
# .../Documents/BrightTable) - never intentional repo content.
secrets.key
secrets.stronghold*

# makepkg build byproducts (packaging/arch/) - source download, extracted
# tree, staged package dir, and built artifacts. Never intentional repo
# content; `makepkg -si` regenerates these from PKGBUILD every time.
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/*.tar.gz
packaging/arch/*.pkg.tar.zst
